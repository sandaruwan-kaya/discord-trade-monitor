# ---------------------------------------------------------------
# Secrets (never commit real values; .env is git-ignored)
# ---------------------------------------------------------------
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
OPENAI_API_KEY=
OPENAI_MODEL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------
# Paper-trading pipeline: EVERYTHING OFF BY DEFAULT.
# With AGENTIC_TRADING_ENABLED=false the app is the original signal
# monitor, whatever the other flags say. There is no live broker.
# ---------------------------------------------------------------
TRADING_MODE=paper
AGENTIC_TRADING_ENABLED=false
AGENT1_ENABLED=false
AGENT2_ENABLED=false
PAPER_EXECUTION_ENABLED=false
AGENT3_ENABLED=false
AGENT4_ENABLED=false
AUTO_EXIT_ENABLED=false
AGENT1_TELEGRAM_DEBUG=false

# Kill switch (blocks NEW entries only; exits are never blocked).
# Alternatively create a file named KILL_SWITCH in the project folder.
TRADING_KILL_SWITCH=0

# Loop cadences (seconds)
PROPOSAL_LOOP_SECONDS=30
RISK_LOOP_SECONDS=60
LIFECYCLE_LOOP_SECONDS=60
EXIT_LOOP_SECONDS=30
PAPER_ENTRY_MAX_PROPOSAL_AGE_SECONDS=300
ENTRY_ORDER_MAX_AGE_MINUTES=15
NOTIFY_RETRY_SECONDS=60

# Paper-trading demo risk limits
MAX_PREMIUM_PER_TRADE=500
MAX_CONTRACTS=2
MAX_DAILY_LOSS=1000
MAX_OPEN_POSITIONS=3
MIN_DTE=7
MAX_DTE=45
MIN_ABS_DELTA=0.35
MAX_ABS_DELTA=0.65
MAX_BID_ASK_SPREAD_PCT=10
MIN_OPEN_INTEREST=100
MIN_OPTION_VOLUME=10
HARD_PREMIUM_STOP_PCT=50
MAX_HOLD_DAYS=5
MAX_POSITION_LOSS=0
AGENT2_MAX_CONFIRMATION_AGE_MINUTES=15
AGENT2_MAX_UNDERLYING_MOVE_PCT=0.5
